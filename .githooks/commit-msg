#!/bin/sh
#
# Rejects any commit that would attribute authorship to a machine.
#
# Installed by `npm install` (see scripts/install-hooks.js), which points
# core.hooksPath at this directory. CI re-checks the whole history, because a
# hook can be skipped with --no-verify and does not exist in a fresh clone
# until someone installs dependencies.
exec node "$(dirname "$0")/../scripts/check-authorship.js" --message "$1"
