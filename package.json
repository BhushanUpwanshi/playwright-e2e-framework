{
  "name": "playwright-e2e-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright E2E framework whose page objects are runner-agnostic — the same screens drive @playwright/test specs and runner-less journeys via playwright-standalone.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check:layering": "node scripts/check-layering.js",
    "clean": "node -e \"for (const d of ['allure-results','allure-report','ctrf','test-results','playwright-report']) require('node:fs').rmSync(d,{recursive:true,force:true})\"",
    "test": "playwright test",
    "test:core": "playwright test --project=core",
    "test:e2e": "playwright test --project=e2e",
    "test:headed": "playwright test --project=e2e --headed",
    "test:standalone": "tsx tests/standalone/checkout.journey.ts",
    "test:standalone:tabs": "tsx tests/standalone/multi-window.journey.ts",
    "test:all": "npm run test && npm run test:standalone && npm run test:standalone:tabs",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
  },
  "keywords": [
    "playwright",
    "e2e",
    "test-automation",
    "page-object-model",
    "typescript",
    "sdet"
  ],
  "author": "Bhushan Upwanshi (https://github.com/BhushanUpwanshi)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20.19.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.1",
    "playwright-ctrf-json-reporter": "^0.0.29",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "playwright-standalone": "^0.1.0"
  }
}
